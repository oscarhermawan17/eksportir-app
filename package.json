{
  "name": "balitrade",
  "private": true,
  "description": "BaliTrade — B2B export marketplace (Bali → Russia & CIS)",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @balitrade/shared build && pnpm --parallel --filter @balitrade/shared --filter @balitrade/api --filter @balitrade/web dev",
    "build": "pnpm --filter @balitrade/shared build && pnpm --filter @balitrade/api build && pnpm --filter @balitrade/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @balitrade/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @balitrade/shared build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @balitrade/api db:migrate",
    "db:seed": "pnpm --filter @balitrade/api db:seed",
    "db:studio": "pnpm --filter @balitrade/api db:studio",
    "docs:api": "python3 scripts/gen-api-docs.py"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}

# Copy to .env NEXT TO docker-compose.prod.yml on the VPS. Never commit the real file.
# Values here are placeholders; generate your own.

# --- images ---
GITHUB_OWNER=oscarhermawan17
# "latest", or a specific commit sha to pin/roll back: sha-<full commit sha>
IMAGE_TAG=latest

# --- domains (also used by the Caddyfile) ---
WEB_DOMAIN=app.example.my.id
API_DOMAIN=api.example.my.id
ACME_EMAIL=you@example.com

# --- API ---
NODE_ENV=production
PORT=4000
# Must be exactly the web address, or logins and chat fail (CORS + cookies).
WEB_ORIGIN=https://app.example.my.id
# PostgreSQL runs on the HOST, not in Docker; host.docker.internal is mapped in docker-compose.prod.yml.
DATABASE_URL=postgresql://balitrade:CHANGE_ME@host.docker.internal:5432/balitrade
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_characters
JWT_EXPIRES_IN_SECONDS=604800

# --- Cloudflare R2 ---
# R2_PRIVATE_BUCKET must be a DIFFERENT bucket from the public one, with public access switched off:
# payment proofs and QC files land there.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PRIVATE_BUCKET=

# --- first admin, created by the seed ---
ADMIN_EMAIL=admin@example.my.id
ADMIN_PASSWORD=CHANGE_ME_min_12_characters
ADMIN_NAME=BaliTrade Admin

# --- where buyers send money (T17) ---
# Keep PAY_MOCK=true until these are real: the payment page then warns that they are placeholders.
PAY_BANK_NAME=BCA
PAY_BANK_ACCOUNT_NUMBER=
PAY_BANK_ACCOUNT_HOLDER=
PAY_USDT_NETWORK=
PAY_USDT_ADDRESS=
PAY_EXCHANGE_NAME=
PAY_EXCHANGE_CONTACT=
PAY_EXCHANGE_INSTRUCTIONS=
PAY_MOCK=true

# Caddy terminates HTTPS and forwards to the containers. Certificates from Let's Encrypt are obtained and
# renewed automatically; there is no certbot and no cron to forget. WebSocket (the order and product chat)
# is forwarded without extra configuration.
#
# WEB_DOMAIN and API_DOMAIN come from the .env file next to docker-compose.prod.yml.

{
	# Where Let's Encrypt sends expiry warnings. Set ACME_EMAIL in .env.
	email {$ACME_EMAIL}
}

{$WEB_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
}

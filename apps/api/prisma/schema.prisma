// BaliTrade database schema — grows task by task (see TASKS.md / ARCHITECTURE.md §5).
// So far: users & roles (T02), seller profiles & QC zones (T07), products (T09), exchange rates (T11).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Keep in sync with packages/shared/src/roles.ts
enum Role {
  BUYER
  SELLER
  ADMIN_OWNER
  ADMIN_FINANCE
  ADMIN_OPS
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String  @map("password_hash")
  name         String
  phone        String?
  /// UI language: en | id | ru
  locale       String  @default("en")
  roles        Role[]  @default([BUYER])

  sellerProfile    SellerProfile?
  reviewedSellers  SellerProfile[] @relation("SellerReviewer")
  reviewedProducts Product[]       @relation("ProductReviewer")
  exchangeRates    ExchangeRate[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Keep in sync with packages/shared/src/seller.ts
enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Bali regency/city where a seller is located; the QC fee depends on it.
model QcZone {
  id        String   @id @default(cuid())
  name      String   @unique
  /// QC fee per order group in USD (exact decimal, never float).
  feeUsd    Decimal  @map("fee_usd") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sellers SellerProfile[]

  @@map("qc_zones")
}

/// A user's application/profile as a seller. Selling is allowed only when status = APPROVED (admin decision).
model SellerProfile {
  id              String       @id @default(cuid())
  userId          String       @unique @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String       @map("display_name")
  about           String?
  /// Null until the seller picks their location; admins cannot approve without it.
  qcZoneId        String?      @map("qc_zone_id")
  qcZone          QcZone?      @relation(fields: [qcZoneId], references: [id])
  status          SellerStatus @default(PENDING)
  rejectionReason String?      @map("rejection_reason")
  reviewedById    String?      @map("reviewed_by_id")
  reviewedBy      User?        @relation("SellerReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?    @map("reviewed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@index([status, createdAt])
  @@map("seller_profiles")
}

/// Keep in sync with packages/shared/src/product.ts
enum ProductType {
  READY_STOCK
  MADE_TO_ORDER
}

/// Keep in sync with packages/shared/src/product.ts
enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

/// A listing. Only APPROVED products are visible to buyers (T10/T12).
model Product {
  id              String        @id @default(cuid())
  sellerId        String        @map("seller_id")
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type            ProductType
  /// One of PRODUCT_CATEGORIES in packages/shared (validated in the API).
  category        String
  /// One of PRODUCT_UNITS in packages/shared (validated in the API).
  unit            String
  /// Price per unit in whole rupiah. USD is derived from the daily rate (T11), never stored here.
  priceIdr        Int           @map("price_idr")
  /// Minimum order quantity.
  moq             Int           @default(1)
  /// READY_STOCK only.
  stockQty        Int?          @map("stock_qty")
  /// MADE_TO_ORDER only.
  leadTimeDays    Int?          @map("lead_time_days")
  /// Language the seller wrote the listing in: en | id.
  sourceLocale    String        @map("source_locale")
  status          ProductStatus @default(DRAFT)
  /// Set when an admin rejects the listing; cleared when it is approved.
  rejectionReason String?       @map("rejection_reason")
  reviewedById    String?       @map("reviewed_by_id")
  reviewedBy      User?         @relation("ProductReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  translations ProductTranslation[]
  media        ProductMedia[]

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("products")
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// en | id | ru
  locale      String
  title       String
  description String
  /// True when produced by machine translation and not yet reviewed (T10).
  isAuto      Boolean  @default(false) @map("is_auto")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([productId, locale])
  @@map("product_translations")
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String    @map("product_id")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Object key in the public R2 bucket.
  r2Key     String    @unique @map("r2_key")
  type      MediaType
  sort      Int
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([productId, sort])
  @@map("product_media")
}

/// Manual USD/IDR rate set by the owner (T11). Append-only history: the newest row is the rate in force,
/// older rows are the audit trail (who set which rate, when). Orders copy the rate they were priced with (T15).
model ExchangeRate {
  id        String   @id @default(cuid())
  /// IDR per 1 USD.
  rate      Decimal  @db.Decimal(12, 4)
  setById   String   @map("set_by_id")
  setBy     User     @relation(fields: [setById], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("exchange_rates")
}

// BaliTrade database schema — grows task by task (see TASKS.md / docs/ARCHITECTURE.md §5).
// So far: users & roles (T02), seller profiles & QC zones (T07), products (T09), exchange rates (T11), chat (T13), notifications (T14), orders (T15).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Keep in sync with packages/shared/src/roles.ts
enum Role {
  BUYER
  SELLER
  ADMIN_OWNER
  ADMIN_FINANCE
  ADMIN_OPS
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String    @map("password_hash")
  name                    String
  phone                   String?
  /// UI language: en | id | ru
  locale                  String    @default("en")
  roles                   Role[]    @default([BUYER])
  /// When the user accepted that a BaliTrade admin takes part in all their chats (null for accounts made by seed/admin).
  adminChatConsentAt      DateTime? @map("admin_chat_consent_at")
  /// Which wording they accepted (ADMIN_CHAT_CONSENT_VERSION in packages/shared).
  adminChatConsentVersion String?   @map("admin_chat_consent_version")

  sellerProfile    SellerProfile?
  reviewedSellers  SellerProfile[] @relation("SellerReviewer")
  reviewedProducts Product[]       @relation("ProductReviewer")
  exchangeRates    ExchangeRate[]

  buyerConversations Conversation[] @relation("ConversationBuyer")
  messages           Message[]
  notifications      Notification[]
  buyerOrders        Order[]        @relation("OrderBuyer")
  submittedPayments  Payment[]      @relation("PaymentSubmittedBy")
  decidedPayments    Payment[]      @relation("PaymentDecidedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Keep in sync with packages/shared/src/seller.ts
enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Bali regency/city where a seller is located; the QC fee depends on it.
model QcZone {
  id        String   @id @default(cuid())
  name      String   @unique
  /// QC fee per order group in USD (exact decimal, never float).
  feeUsd    Decimal  @map("fee_usd") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sellers SellerProfile[]

  @@map("qc_zones")
}

/// A user's application/profile as a seller. Selling is allowed only when status = APPROVED (admin decision).
model SellerProfile {
  id              String       @id @default(cuid())
  userId          String       @unique @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String       @map("display_name")
  about           String?
  /// Null until the seller picks their location; admins cannot approve without it.
  qcZoneId        String?      @map("qc_zone_id")
  qcZone          QcZone?      @relation(fields: [qcZoneId], references: [id])
  status          SellerStatus @default(PENDING)
  rejectionReason String?      @map("rejection_reason")
  reviewedById    String?      @map("reviewed_by_id")
  reviewedBy      User?        @relation("SellerReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?    @map("reviewed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  products      Product[]
  conversations Conversation[]
  orders        Order[]

  @@index([status, createdAt])
  @@map("seller_profiles")
}

/// Keep in sync with packages/shared/src/product.ts
enum ProductType {
  READY_STOCK
  MADE_TO_ORDER
}

/// Keep in sync with packages/shared/src/product.ts
enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

/// A listing. Only APPROVED products are visible to buyers (T10/T12).
model Product {
  id              String        @id @default(cuid())
  sellerId        String        @map("seller_id")
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type            ProductType
  /// Key of a ProductCategory row (T26). The column is still called `category`, so no product row moved
  /// when categories became data; the foreign key is on the slug, with ON DELETE RESTRICT.
  categorySlug    String        @map("category")
  category        ProductCategory @relation(fields: [categorySlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  /// One of PRODUCT_UNITS in packages/shared (validated in the API).
  unit            String
  /// Price per unit in whole rupiah. USD is derived from the daily rate (T11), never stored here.
  priceIdr        Int           @map("price_idr")
  /// Minimum order quantity.
  moq             Int           @default(1)
  /// READY_STOCK only.
  stockQty        Int?          @map("stock_qty")
  /// MADE_TO_ORDER only.
  leadTimeDays    Int?          @map("lead_time_days")
  /// Language the seller wrote the listing in: en | id.
  sourceLocale    String        @map("source_locale")
  status          ProductStatus @default(DRAFT)
  /// Set when an admin rejects the listing; cleared when it is approved.
  rejectionReason String?       @map("rejection_reason")
  reviewedById    String?       @map("reviewed_by_id")
  reviewedBy      User?         @relation("ProductReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  translations  ProductTranslation[]
  media         ProductMedia[]
  conversations Conversation[]
  orderItems    OrderItem[]

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@index([categorySlug])
  @@map("products")
}

/// Product categories, managed by the OWNER at /admin/categories (T26). They used to be the
/// PRODUCT_CATEGORIES constant in packages/shared, which meant forbidding a category needed a deploy.
model ProductCategory {
  id         String    @id @default(cuid())
  /// Stable key in SCREAMING_SNAKE_CASE, e.g. COFFEE_TEA. Products reference it, so it is never edited
  /// once a product uses it; the label is what admins change.
  slug       String    @unique
  nameEn     String    @map("name_en")
  nameId     String    @map("name_id")
  nameRu     String    @map("name_ru")
  /// Unchecked by an admin (regulation, a forbidden good): the products keep the category but disappear
  /// from the catalog, the filters and /products/[id], which answers 404. Their ProductStatus is left
  /// alone, so checking the box again restores everything without touching a product row.
  active     Boolean   @default(true)
  /// Soft delete: same effect as active = false, and hidden from the admin list as well. Deleting for
  /// real is only offered when no product references the category — the FK above refuses it otherwise.
  archivedAt DateTime? @map("archived_at")
  /// Order of the chips on the catalog and of the options in the seller's form.
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@index([active, archivedAt, sortOrder])
  @@map("product_categories")
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// en | id | ru
  locale      String
  title       String
  description String
  /// True when produced by machine translation and not yet reviewed (T10).
  isAuto      Boolean  @default(false) @map("is_auto")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([productId, locale])
  @@map("product_translations")
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String    @map("product_id")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Object key in the public R2 bucket.
  r2Key     String    @unique @map("r2_key")
  type      MediaType
  sort      Int
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([productId, sort])
  @@map("product_media")
}

/// Manual USD/IDR rate set by the owner (T11). Append-only history: the newest row is the rate in force,
/// older rows are the audit trail (who set which rate, when). Orders copy the rate they were priced with (T15).
model ExchangeRate {
  id        String   @id @default(cuid())
  /// IDR per 1 USD.
  rate      Decimal  @db.Decimal(12, 4)
  setById   String   @map("set_by_id")
  setBy     User     @relation(fields: [setById], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("exchange_rates")
}

/// Keep in sync with packages/shared/src/chat.ts
enum ConversationType {
  PRODUCT_INQUIRY
  ORDER
}

/// A chat between one buyer and one seller. BaliTrade admins (ADMIN_OPS / ADMIN_OWNER) take part in every
/// conversation implicitly (access comes from the role, so no participant rows are needed).
model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  /// Set for product inquiries. Kept (set to null) if the product is ever deleted, so the history survives.
  productId     String?          @map("product_id")
  product       Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  buyerId       String           @map("buyer_id")
  buyer         User             @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId      String           @map("seller_id")
  seller        SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// Set for the chat of an order (productId is then null).
  orderId       String?          @unique @map("order_id")
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  messages Message[]

  /// One inquiry per buyer and product (rows without a product, e.g. order chats, are not limited).
  @@unique([buyerId, productId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Null for SYSTEM messages (order events), which have no author.
  senderId       String?      @map("sender_id")
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind           MessageKind  @default(USER)
  body           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Keep in sync with packages/shared/src/notifications.ts
enum NotificationType {
  CHAT_MESSAGE
  ORDER_REQUESTED
  ORDER_STATUS
}

/// An in-app notification for one user. Unread notifications about the same subject are folded into one row
/// (e.g. 5 new messages in a conversation = one row with count 5); once read, the next event creates a fresh row.
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  /// What the notification is about, e.g. "conversation:<id>".
  subject   String
  /// Shape depends on `type` (see packages/shared/src/notifications.ts).
  payload   Json
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([userId, readAt, updatedAt])
  @@index([userId, type, subject, readAt])
  @@map("notifications")
}

enum MessageKind {
  USER
  SYSTEM
}

/// Keep in sync with packages/shared/src/orders.ts (flow: docs/ARCHITECTURE.md §6).
enum OrderStatus {
  REQUESTED
  ACCEPTED
  CHANGE_PROPOSED
  DECLINED
  AWAITING_PAYMENT
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  IN_QC
  QC_READY
  QC_APPROVED
  ISSUE
  AWAITING_SHIPPING_PAYMENT
  SHIPPING_PAID
  SHIPPED
  ARRIVED
  COMPLETED
  CANCELLED
  REFUNDED
}

/// Keep in sync with packages/shared/src/orders.ts
enum OrderItemResponse {
  PENDING
  ACCEPTED
  DECLINED
  CHANGE_PROPOSED
}

/// Keep in sync with packages/shared/src/payments.ts
enum PaymentMethod {
  BANK_IDR
  USDT
  EXCHANGE
}

/// Keep in sync with packages/shared/src/payments.ts. SHIPPING is used by T19.
enum PaymentPurpose {
  GOODS
  SHIPPING
}

/// Keep in sync with packages/shared/src/payments.ts
enum PaymentStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

/// One buyer, one seller, one item (MVP 1.0). Prices, the exchange rate and the QC fee are copied at the moment of the
/// request, so later changes to the product, the rate or the QC tariff never alter an existing order.
model Order {
  id              String        @id @default(cuid())
  /// Shown as OR-<1000 + number>.
  number          Int           @unique @default(autoincrement())
  buyerId         String        @map("buyer_id")
  buyer           User          @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId        String        @map("seller_id")
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status          OrderStatus   @default(REQUESTED)
  /// DeliveryAddress (packages/shared/src/orders.ts); visible to the buyer and admins only.
  deliveryAddress Json          @map("delivery_address")
  /// IDR per 1 USD used for this order.
  fxRate          Decimal       @map("fx_rate") @db.Decimal(12, 4)
  itemsUsd        Decimal       @map("items_usd") @db.Decimal(12, 2)
  qcFeeUsd        Decimal       @map("qc_fee_usd") @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  items        OrderItem[]
  conversation Conversation?
  payments     Payment[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

/// One attempt by the buyer to pay (T17). Rows are never edited or replaced: a rejected or partial payment stays, and
/// the next proof is a new row, so the admin reads the whole history. Partial amounts are allowed on purpose, which is
/// why nothing here computes "paid" — a FINANCE admin decides that by moving the order to PAYMENT_VERIFIED.
model Payment {
  id              String         @id @default(cuid())
  orderId         String         @map("order_id")
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purpose         PaymentPurpose @default(GOODS)
  method          PaymentMethod
  status          PaymentStatus  @default(SUBMITTED)
  /// Always set: for the rupiah routes it is `amountIdr` converted at the order's locked `fxRate`.
  amountUsd       Decimal        @map("amount_usd") @db.Decimal(12, 2)
  /// What the buyer actually typed on the rupiah routes (the figure the admin looks for in the statement); null for USDT.
  amountIdr       Int?           @map("amount_idr")
  /// BANK_IDR: whose account the transfer came from (often not the buyer).
  senderName      String?        @map("sender_name")
  /// USDT: transaction hash.
  txHash          String?        @map("tx_hash")
  /// EXCHANGE: which exchange was paid, and its transfer reference.
  exchangeName    String?        @map("exchange_name")
  reference       String?
  note            String?
  /// Key in the private R2 bucket; readable only through a short-lived signed URL (buyer and admins).
  proofKey        String         @map("proof_key")
  submittedById   String         @map("submitted_by_id")
  submittedBy     User           @relation("PaymentSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  submittedAt     DateTime       @default(now()) @map("submitted_at")
  /// The FINANCE admin who verified or rejected it. Together with the timestamps this is the audit trail for money
  /// (a full admin audit log is MVP 1.1); every decision also writes a system message into the order chat.
  decidedById     String?        @map("decided_by_id")
  decidedBy       User?          @relation("PaymentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?      @map("decided_at")
  rejectionReason String?        @map("rejection_reason")

  @@index([orderId, submittedAt])
  @@index([status, submittedAt])
  @@map("payments")
}

model OrderItem {
  id             String            @id @default(cuid())
  orderId        String            @map("order_id")
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Kept (set to null) if the product is ever deleted; the snapshot below is what counts.
  productId      String?           @map("product_id")
  product        Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Snapshot of the product at the time of the request.
  title          String
  unit           String
  qty            Int
  unitPriceIdr   Int               @map("unit_price_idr")
  unitPriceUsd   Decimal           @map("unit_price_usd") @db.Decimal(12, 2)
  /// "Note to seller" from the buyer.
  note           String?
  sellerResponse OrderItemResponse @default(PENDING) @map("seller_response")
  proposedQty    Int?              @map("proposed_qty")

  @@index([orderId])
  @@map("order_items")
}

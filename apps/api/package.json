{
  "name": "@balitrade/api",
  "version": "0.1.0",
  "private": true,
  "description": "BaliTrade REST API + WebSocket (NestJS)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node ../../scripts/db-local.mjs vitest run --config ./vitest.config.e2e.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node ../../scripts/db-local.mjs prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node ../../scripts/db-local.mjs prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@balitrade/shared": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.3.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "oxlint": "1.89.0",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}

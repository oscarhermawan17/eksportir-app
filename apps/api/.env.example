# Copy to apps/api/.env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Web app origin allowed by CORS (credentials/cookies).
WEB_ORIGIN=http://localhost:3000

# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://balitrade:balitrade@localhost:5432/balitrade

# First admin account created by `pnpm db:seed` (min. 12 characters).
ADMIN_EMAIL=admin@balitrade.local
ADMIN_PASSWORD=change-me-please-123
ADMIN_NAME=BaliTrade Admin

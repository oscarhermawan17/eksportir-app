# Copy to apps/api/.env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Web app origin allowed by CORS (credentials/cookies).
WEB_ORIGIN=http://localhost:3000

# --- Database (two URLs on purpose, decided 2026-11-12) ---
# DATABASE_URL is what the app, `pnpm dev` and `pnpm db:studio` read. The default below is the VPS
# testing database through the SSH tunnel on port 5433, so a fresh clone works anywhere with real data:
#   1. pnpm db:tunnel      (leave it running; opens localhost:5433 → VPS PostgreSQL over SSH)
#   2. pnpm setup          (generates the Prisma client + shared package, then checks both URLs)
#   3. pnpm dev
# `pnpm db:check` says which database each line points at and whether it answers.
DATABASE_URL=postgresql://balitrade:PASSWORD_FROM_THE_VPS@localhost:5433/balitrade
# To work fully offline instead, point it at the local Docker database (`pnpm db:up`):
# DATABASE_URL=postgresql://balitrade:balitrade@localhost:5432/balitrade
#
# LOCAL_DATABASE_URL is the local Docker database, and the ONLY one that `pnpm db:migrate`,
# `pnpm db:seed` and `pnpm --filter @balitrade/api test:e2e` are allowed to touch: those three can
# destroy data (`migrate dev` can offer to reset the database, the e2e suite deletes users), and the
# VPS holds the only copy of the testing orders and payment proofs. scripts/db-local.mjs enforces it.
# Schema changes therefore go: `pnpm db:migrate` locally → commit → `pnpm db:deploy` through the tunnel.
LOCAL_DATABASE_URL=postgresql://balitrade:balitrade@localhost:5432/balitrade

# Secret used to sign session JWTs (min. 32 characters). Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-32chars
# Session lifetime in seconds (default 7 days).
JWT_EXPIRES_IN_SECONDS=604800

# --- Cloudflare R2 (photos & videos) ---
# Leave all empty to run without media upload (the media endpoints answer 503). All six are required in production.
# See "Cloudflare R2 setup" in docs/ARCHITECTURE.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
# Must be a DIFFERENT bucket from R2_PUBLIC_BUCKET, with public access (r2.dev) switched OFF.
# Payment proofs and QC files land here; they carry account numbers and full names, so a public
# bucket would make the URL the only thing protecting them.
R2_PRIVATE_BUCKET=

# --- Where buyers send their money (T17) ---
# Mock values are fine in development; the payment page reads them at runtime, so going live is an
# .env change and a restart, never a code change. A method whose fields are empty is NOT offered to
# buyers, so a half-filled block cannot show an incomplete instruction.
PAY_BANK_NAME=BCA
PAY_BANK_ACCOUNT_NUMBER=1234567890
PAY_BANK_ACCOUNT_HOLDER=PT BaliTrade Mock
# TRC20 | ERC20 | BEP20 — shown to the buyer verbatim. Still undecided for real use; the wrong
# network loses the buyer's funds, so it must match the Binance wallet exactly.
PAY_USDT_NETWORK=TRC20
PAY_USDT_ADDRESS=TMockUsdtAddressForDevelopmentOnly00
PAY_EXCHANGE_NAME=Mock Exchange Bali
PAY_EXCHANGE_CONTACT=@mock_exchange_bali
PAY_EXCHANGE_INSTRUCTIONS=Development placeholder. Tell the exchange your order number and ask them for the transfer reference.
# Keep true while the values above are placeholders: the payment page then warns that this is not real.
PAY_MOCK=true

# First admin account created by `pnpm db:seed` (min. 12 characters).
ADMIN_EMAIL=admin@balitrade.local
ADMIN_PASSWORD=change-me-please-123
ADMIN_NAME=BaliTrade Admin
